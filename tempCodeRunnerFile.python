
while True:
    nilai = int(input("Masukkan nilai mahasiswa: "))

    if 85 <= nilai <= 100:
        grade = 'A'
    elif 70 <= nilai < 85:
        grade = 'B'
    elif 55 <= nilai < 70:
        grade = 'C'
    elif 0 <= nilai < 55:
        grade = 'D'
    else:
        print("Nilai tidak valid!")
        exit()

    hasil = f"Nilai {nilai} = Grade {grade}"
    if grade == 'D':
        hasil += " (Remedial)"
        
    print(hasil)
